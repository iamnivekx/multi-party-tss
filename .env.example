# rocket
ROCKET_PORT=8000
ROCKET_ADDRESS=0.0.0.0
RUST_BACKTRACE=1

# log
RUST_LOG=info
RUST_LOG_DIRECTORY=logs
RUST_LOG_FILE_PREFIX_NAME=combined.log

# GG18
GG18_ENABLE_DISTRIBUTED=true
GG18_COMMUNICATE_ENDPOINT=http://127.0.0.1:8000/ecdsa/gg_18/management/

# GG20
GG20_ENABLE_DISTRIBUTED=true
GG20_COMMUNICATE_ENDPOINT=http://127.0.0.1:8000/ecdsa/gg_20/management/
NODE_REQUEST_DELAY=10 # ms
NODE_REQUEST_MAX_TIMEOUT=10000 # ms

# DB
POSTGRES_URL='postgres://ph:123456@localhost/tss'
PG_CONNECTION_POOL_SIZE=10
PG_CONNECTION_FDW_POOL_SIZE=10
PG_CONNECTION_EXTRA_QUERY_PERMITS=0


